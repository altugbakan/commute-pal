<Window x:Class="CommutePal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CommutePal.Controls"
        Title="CommutePal"
        Icon="Assets/bike.ico"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        KeyDown="Window_KeyDown">

    <StackPanel Margin="16,14,16,14">

        <!-- Day navigator: arrows step a day, clicking the date opens the month picker, "Today" jumps back. -->
        <Grid Margin="5,0,5,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource ArrowButton}" Content="‹" ToolTip="Previous day" Click="PrevDay_Click"/>
            <Button x:Name="DateButton" Grid.Column="1" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                    Foreground="{DynamicResource TextPrimary}" ToolTip="Pick a date to backfill" Click="DateButton_Click">
                <TextBlock x:Name="DateText" FontSize="18" FontWeight="SemiBold"/>
            </Button>
            <Button x:Name="TodayButton" Grid.Column="2" Style="{StaticResource FlatButton}" Content="Today"
                    FontSize="12" Margin="0,0,4,0" Click="Today_Click"/>
            <Button x:Name="NextDayButton" Grid.Column="3" Style="{StaticResource ArrowButton}" Content="›" ToolTip="Next day" Click="NextDay_Click"/>
            <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=DateButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <controls:MonthPicker x:Name="Picker" Margin="0,4,0,0" DateSelected="Picker_DateSelected"/>
            </Popup>
        </Grid>

        <UniformGrid x:Name="ModeGrid" Columns="2" Rows="2">
            <Button Style="{StaticResource TileButton}" Tag="Bike" Click="ModeButton_Click">
                <StackPanel>
                    <Viewbox Width="26" Height="26" Margin="0,0,0,4"><Path Style="{StaticResource Icon}" Data="{StaticResource BikeIcon}"/></Viewbox>
                    <TextBlock Text="Bike" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TileButton}" Tag="Car" Click="ModeButton_Click">
                <StackPanel>
                    <Viewbox Width="26" Height="26" Margin="0,0,0,4"><Path Style="{StaticResource Icon}" Data="{StaticResource CarIcon}"/></Viewbox>
                    <TextBlock Text="Car" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TileButton}" Tag="PublicTransport" Click="ModeButton_Click">
                <StackPanel>
                    <Viewbox Width="26" Height="26" Margin="0,0,0,4"><Path Style="{StaticResource Icon}" Data="{StaticResource BusIcon}"/></Viewbox>
                    <TextBlock Text="Public transport" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TileButton}" Tag="Home" Click="ModeButton_Click">
                <StackPanel>
                    <Viewbox Width="26" Height="26" Margin="0,0,0,4"><Path Style="{StaticResource Icon}" Data="{StaticResource HomeIcon}"/></Viewbox>
                    <TextBlock Text="Home" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Border Style="{StaticResource Card}" Padding="14,10" Margin="5,14,5,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="84"/>
                    <ColumnDefinition Width="Auto" MinWidth="84"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ThisMonthHeader" Grid.Row="0" Grid.Column="2" Style="{StaticResource StatHeader}"/>
                <TextBlock x:Name="LastMonthHeader" Grid.Row="0" Grid.Column="3" Style="{StaticResource StatHeader}"/>

                <Viewbox Grid.Row="1" Grid.Column="0" Style="{StaticResource StatIcon}"><Path Style="{StaticResource Icon}" Data="{StaticResource BikeIcon}"/></Viewbox>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Bike" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="BikeThis" Grid.Row="1" Grid.Column="2" Style="{StaticResource StatValue}"/>
                <TextBlock x:Name="BikeLast" Grid.Row="1" Grid.Column="3" Style="{StaticResource StatValue}"/>

                <Viewbox Grid.Row="2" Grid.Column="0" Style="{StaticResource StatIcon}"><Path Style="{StaticResource Icon}" Data="{StaticResource CarIcon}"/></Viewbox>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Car" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="CarThis" Grid.Row="2" Grid.Column="2" Style="{StaticResource StatValue}"/>
                <TextBlock x:Name="CarLast" Grid.Row="2" Grid.Column="3" Style="{StaticResource StatValue}"/>

                <Viewbox Grid.Row="3" Grid.Column="0" Style="{StaticResource StatIcon}"><Path Style="{StaticResource Icon}" Data="{StaticResource BusIcon}"/></Viewbox>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Public transport" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="PtThis" Grid.Row="3" Grid.Column="2" Style="{StaticResource StatValue}"/>
                <TextBlock x:Name="PtLast" Grid.Row="3" Grid.Column="3" Style="{StaticResource StatValue}"/>

                <Viewbox Grid.Row="4" Grid.Column="0" Style="{StaticResource StatIcon}"><Path Style="{StaticResource Icon}" Data="{StaticResource HomeIcon}"/></Viewbox>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Home" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="HomeThis" Grid.Row="4" Grid.Column="2" Style="{StaticResource StatValue}"/>
                <TextBlock x:Name="HomeLast" Grid.Row="4" Grid.Column="3" Style="{StaticResource StatValue}"/>

                <Border Grid.Row="5" Grid.ColumnSpan="4" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="Days" Style="{StaticResource StatLabel}" Margin="0,8,0,0"/>
                <TextBlock x:Name="TotalThis" Grid.Row="5" Grid.Column="2" Style="{StaticResource StatValue}" Margin="0,8,0,0"/>
                <TextBlock x:Name="TotalLast" Grid.Row="5" Grid.Column="3" Style="{StaticResource StatValue}" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <DockPanel Margin="5,12,5,0">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                <Hyperlink Click="OpenLog_Click">Open log folder</Hyperlink>
            </TextBlock>
            <CheckBox x:Name="StartupCheckBox" Content="Ask at sign-in" VerticalAlignment="Center"
                      Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"/>
        </DockPanel>
    </StackPanel>
</Window>
