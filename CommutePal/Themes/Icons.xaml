<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 24x24 outline icons, stroke only. Wrap a Path in a Viewbox to render at other sizes. -->

    <GeometryGroup x:Key="BikeIcon">
        <EllipseGeometry Center="5.5,17.5" RadiusX="3.5" RadiusY="3.5"/>
        <EllipseGeometry Center="18.5,17.5" RadiusX="3.5" RadiusY="3.5"/>
        <!-- frame: rear hub, seat top, head tube, front hub; seat tube; down tube; chain stay -->
        <PathGeometry Figures="M5.5 17.5 L9.5 9 L15 8.5 L18.5 17.5 M9.5 9 L12.5 17.5 L15 8.5 M5.5 17.5 L12.5 17.5"/>
        <!-- seat and handlebar -->
        <PathGeometry Figures="M9.5 9 V7.5 M8 7.5 H11 M15 8.5 L15.5 6 M14 6 H17"/>
    </GeometryGroup>

    <GeometryGroup x:Key="CarIcon">
        <PathGeometry Figures="M3 15.5 V12 L5.5 7.5 H15.5 L18.5 11.5 L21 12 V15.5 Z M3.5 12 H18"/>
        <EllipseGeometry Center="7,17.25" RadiusX="1.75" RadiusY="1.75"/>
        <EllipseGeometry Center="17,17.25" RadiusX="1.75" RadiusY="1.75"/>
    </GeometryGroup>

    <GeometryGroup x:Key="BusIcon">
        <PathGeometry Figures="M4 15.5 V6.5 A2 2 0 0 1 6 4.5 H18 A2 2 0 0 1 20 6.5 V15.5 Z M4 11 H20 M7.5 13.5 H8 M16 13.5 H16.5"/>
        <EllipseGeometry Center="7.5,17.25" RadiusX="1.75" RadiusY="1.75"/>
        <EllipseGeometry Center="16.5,17.25" RadiusX="1.75" RadiusY="1.75"/>
    </GeometryGroup>

    <GeometryGroup x:Key="HomeIcon">
        <PathGeometry Figures="M3 11 L12 4 L21 11 V20 H3 Z M10 20 V14 H14 V20"/>
    </GeometryGroup>

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>

</ResourceDictionary>
