<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        24x24 outline icons from Lucide (https://lucide.dev), ISC licence, see THIRD_PARTY_NOTICES.md.
        Stroke only. Wrap a Path in a Viewbox to render at other sizes.
    -->

    <!-- lucide: bike -->
    <GeometryGroup x:Key="BikeIcon">
        <EllipseGeometry Center="18.5,17.5" RadiusX="3.5" RadiusY="3.5"/>
        <EllipseGeometry Center="5.5,17.5" RadiusX="3.5" RadiusY="3.5"/>
        <EllipseGeometry Center="15,5" RadiusX="1" RadiusY="1"/>
        <PathGeometry Figures="M12 17.5V14l-3-3 4-3 2 3h2"/>
    </GeometryGroup>

    <!-- lucide: car -->
    <GeometryGroup x:Key="CarIcon">
        <PathGeometry Figures="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/>
        <EllipseGeometry Center="7,17" RadiusX="2" RadiusY="2"/>
        <PathGeometry Figures="M9 17h6"/>
        <EllipseGeometry Center="17,17" RadiusX="2" RadiusY="2"/>
    </GeometryGroup>

    <!-- lucide: bus -->
    <GeometryGroup x:Key="BusIcon">
        <PathGeometry Figures="M8 6v6"/>
        <PathGeometry Figures="M15 6v6"/>
        <PathGeometry Figures="M2 12h19.6"/>
        <PathGeometry Figures="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3"/>
        <EllipseGeometry Center="7,18" RadiusX="2" RadiusY="2"/>
        <PathGeometry Figures="M9 18h5"/>
        <EllipseGeometry Center="16,18" RadiusX="2" RadiusY="2"/>
    </GeometryGroup>

    <!-- lucide: house -->
    <GeometryGroup x:Key="HomeIcon">
        <PathGeometry Figures="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
        <PathGeometry Figures="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
    </GeometryGroup>

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>

</ResourceDictionary>
